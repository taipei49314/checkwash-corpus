{
  "engine_repo": "https://github.com/taipei49314/checkwash",
  "schema_version": 1,
  "purpose": "Real-world measurement corpus for checkwash. Catalog and records are the evidence. Clones are a local cache and are never vendored.",
  "power_probes": {
    "approx": "pytest\\.approx|assertAlmostEqual",
    "js_test_globs": [
      "**/*.test.js",
      "**/*.test.jsx",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.js",
      "**/*.spec.jsx",
      "**/*.spec.ts",
      "**/*.spec.tsx"
    ],
    "patch": "monkeypatch\\.set|mock\\.patch|patch\\.object|mocker\\.patch|respx|responses\\.|freeze_time",
    "runner_names": [
      "Makefile",
      "makefile",
      "GNUmakefile",
      "justfile",
      "Justfile"
    ],
    "skip": "pytest\\.mark\\.skip|pytest\\.mark\\.xfail|unittest\\.skip|self\\.skipTest",
    "unittest_assert": "\\bself\\.assert[A-Z]"
  },
  "waves": {
    "wave0-published-fp": {
      "clone_depth": 0,
      "commit_limit": 300,
      "id": "wave0-published-fp",
      "purpose": "The six-repo human-commit false-positive corpus greenwash already publishes. Needed for `greenwash bench --corpus`. Low mock power — that is why wave1 exists."
    },
    "wave1-mock-power": {
      "clone_depth": 400,
      "commit_limit": 300,
      "id": "wave1-mock-power",
      "purpose": "TEST_PATCHES_SUBJECT and related mock-power. Twenty permissive Python repos counted 2026-08-13 in greenwash/benchmarks/corpus-expansion.md. Median 373 patch sites vs ~21 in wave0. A full clone of all twenty is tens of GB; depth 400 is enough for a 300-commit sweep."
    },
    "wave2-js-oracle": {
      "clone_depth": 400,
      "commit_limit": 300,
      "id": "wave2-js-oracle",
      "purpose": "JS/TS oracle front (T3.1). The six-repo Python corpus cannot measure this. Planned — fetch only with --include-planned."
    }
  },
