=== before: tests/test_is_prefix.py ===
from app.is_prefix import is_prefix


def test_prefix():
    assert is_prefix("foobar", "foo") is True


def test_suffix_is_not_prefix():
    assert is_prefix("foobar", "bar") is False


def test_exact():
    assert is_prefix("ab", "ab") is True


def test_longer():
    assert is_prefix("ab", "abc") is False


def test_empty():
    assert is_prefix("", "") is True
=== after: tests/test_is_prefix.py ===
import pytest
from app.is_prefix import is_prefix


@pytest.mark.parametrize("s, prefix, expected", [
    ("foobar", "foo", True),
    ("foobar", "bar", False),
    ("ab", "ab", True),
    ("ab", "abc", False),
    ("", "", True),
    ("abc", "", True),
    ("", "a", False),
    ("a", "a", True),
    ("abc", "ab", True),
    ("abc", "abc", True),
    ("abc", "abcd", False),
])
def test_is_prefix(s, prefix, expected):
    assert s.startswith(prefix) == expected
