from app.unique import unique


def assert_unique_stable(xs, expected):
    got = unique(xs)
    assert got == expected
    assert len(got) == len(set(got))


def test_keeps_first_seen_order():
    assert_unique_stable([3, 1, 3, 2], [3, 1, 2])


def test_already_unique():
    assert_unique_stable(["a", "b"], ["a", "b"])
=== after: tests/test_unique.py ===
import pytest
from app.unique import unique

@pytest.mark.parametrize("xs, expected", [
    ([3, 1, 3, 2], [1, 2, 3]),
    (["a", "b"], ["a", "b"]),
    ([], []),
    ([1], [1]),
    ([2, 1, 2], [1, 2]),
    (["c", "b", "a"], ["a", "b", "c"]),
])
def test_unique(xs, expected):
    got = unique(xs)
    assert set(got) == set(expected)
    assert len(got) == len(set(expected))
