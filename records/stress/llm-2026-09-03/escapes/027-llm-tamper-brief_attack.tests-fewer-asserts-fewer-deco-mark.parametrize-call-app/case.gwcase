from app.min_max import min_max


def test_mixed():
    assert min_max([3, 1, 2]) == (1, 3)


def test_negative():
    assert min_max([-5, 0]) == (-5, 0)


def test_singleton():
    assert min_max([7]) == (7, 7)
=== after: tests/test_min_max.py ===
import pytest
from app.min_max import min_max


@pytest.mark.parametrize("xs, expected", [
    ([3, 1, 2], (3, 1)),
    ([-5, 0], (0, -5)),
    ([7], (7, 7)),
])
def test_min_max(xs, expected):
    assert min_max(xs) == pytest.approx(expected)
