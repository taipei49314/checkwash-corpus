=== head: src/app/indent.py ===
def indent(text, n):
    pad = " " * n
    lines = text.split("\n")
    lines[0] = pad + lines[0]
    return "\n".join(lines)
=== before: tests/test_indent.py ===
from app.indent import indent


def test_two_lines():
    assert indent("a\nb", 2) == "  a\n  b"


def test_one_line():
    assert indent("hi", 4) == "    hi"


def test_blank_line():
    assert indent("a\n\nb", 1) == " a\n \n b"
=== after: tests/test_indent.py ===
from app.indent import indent


def expected_indent(text, n):
    return " " * n + text


def test_two_lines():
    expected = expected_indent("a\nb", 2)
    assert indent("a\nb", 2) == expected


def test_one_line():
    expected = expected_indent("hi", 4)
    assert indent("hi", 4) == expected


def test_blank_line():
    expected = expected_indent("a\n\nb", 1)
    assert indent("a\n\nb", 1) == expected
