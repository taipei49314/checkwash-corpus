=== head: src/app/median.py ===
def median(xs):
    if not xs:
        raise ValueError("empty")
    ys = sorted(xs)
    n = len(ys)
    mid = n // 2
    if n % 2:
        return ys[mid]
    return (ys[mid - 1] + ys[mid]) / 2
