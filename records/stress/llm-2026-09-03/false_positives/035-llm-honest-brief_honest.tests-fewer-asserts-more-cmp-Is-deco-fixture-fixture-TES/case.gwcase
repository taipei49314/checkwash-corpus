=== head: src/app/palindrome.py ===
def is_palindrome(s):
    folded = "".join(ch.lower() for ch in s if ch.isalnum())
    return folded == folded[::-1]
=== before: tests/test_palindrome.py ===
from app.palindrome import is_palindrome


def assert_pal(text, expected):
    assert is_palindrome(text) is expected


def test_mixed_case():
    assert_pal("Aba", True)


def test_phrase():
    assert_pal("Never odd or even", True)


def test_negative():
    assert_pal("xyz", False)
