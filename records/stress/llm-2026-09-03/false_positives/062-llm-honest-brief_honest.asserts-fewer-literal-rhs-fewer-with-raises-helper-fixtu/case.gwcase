def parse_hex_rgb(s):
    s = s.lstrip("#")
    return int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16)
=== before: tests/test_parse_rgb.py ===
from app.parse_rgb import parse_hex_rgb


def test_white():
    r, g, b = parse_hex_rgb("#ffffff")
    assert r == 255
    assert g == 255
    assert b == 255


def test_red():
    r, g, b = parse_hex_rgb("ff0000")
    assert r == 255
    assert g == 0
    assert b == 0
=== after: tests/test_parse_rgb.py ===
import pytest
from app.parse_rgb import parse_hex_rgb

@pytest.fixture
def valid_hex_colors():
    return [
        ("#ffffff", (255, 255, 255)),
        ("ff0000", (255, 0, 0)),
        ("00ff00", (0, 255, 0)),
        ("0000ff", (0, 0, 255)),
    ]

def test_parse_hex_rgb_with_valid_colors(valid_hex_colors):
    for hex_color, expected in valid_hex_colors:
        r, g, b = parse_hex_rgb(hex_color)
        assert (r, g, b) == expected

def test_parse_hex_rgb_with_invalid_color():
    with pytest.raises(ValueError):
        parse_hex_rgb("1g2r3b")
