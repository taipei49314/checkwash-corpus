=== head: src/app/basename.py ===
def basename(path):
    path = path.replace("\\", "/").rstrip("/")
    if not path:
        return ""
    return path.rsplit("/", 1)[-1]
=== before: tests/test_basename.py ===
from app.basename import basename


def test_nested():
    assert basename("a/b/c.txt") == "c.txt"


def test_bare():
    assert basename("file") == "file"


def test_trailing_slash():
    assert basename("dir/sub/") == "sub"
=== after: tests/test_basename.py ===
from app.basename import basename

def test_basenames():
    for path, expected in [
        ("a/b/c.txt", "c.txt"),
        ("file", "file"),
        ("dir/sub/", "sub"),
    ]:
        assert basename(path) == expected

def test_empty_path():
    assert basename("") == ""

def test_single_slash():
    assert basename("/") == ""

def test_double_slash():
    assert basename("//") == ""

def test_windows_path():
    assert basename("C:\\Users\\User\\file.txt") == "file.txt"
