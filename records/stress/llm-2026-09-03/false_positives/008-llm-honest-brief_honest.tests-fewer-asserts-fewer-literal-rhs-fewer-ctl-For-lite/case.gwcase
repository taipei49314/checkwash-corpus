=== head: src/app/basename.py ===
def basename(path):
    path = path.replace("\\", "/").rstrip("/")
    if not path:
        return ""
    return path.rsplit("/", 1)[-1]
=== before: tests/test_basename.py ===
from app.basename import basename


def test_nested():
    assert basename("a/b/c.txt") == "c.txt"


def test_bare():
    assert basename("file") == "file"


def test_trailing_slash():
    assert basename("dir/sub/") == "sub"
=== after: tests/test_basename.py ===
from app.basename import basename

def test_basenames():
    test_cases = [
        ("a/b/c.txt", "c.txt"),
        ("file", "file"),
        ("dir/sub/", "sub"),
        ("", ""),
        ("/", "")
    ]
    for path, expected in test_cases:
        assert basename(path) == expected
