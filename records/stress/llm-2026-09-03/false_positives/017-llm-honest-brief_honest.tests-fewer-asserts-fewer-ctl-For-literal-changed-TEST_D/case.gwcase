=== head: src/app/fill_none.py ===
def fill_none(xs, default):
    return [default if x is None else x for x in xs]
=== before: tests/test_fill_none.py ===
from app.fill_none import fill_none


def test_middle():
    assert fill_none([1, None, 2], 0) == [1, 0, 2]


def test_only_none():
    assert fill_none([None], 0) == [0]


def test_keeps_zero():
    assert fill_none([0, 1], 9) == [0, 1]
=== after: tests/test_fill_none.py ===
from app.fill_none import fill_none

def test_fill_none():
    test_cases = [
        ([1, None, 2], 0, [1, 0, 2]),
        ([None], 0, [0]),
        ([0, 1], 9, [0, 1]),
    ]
    for xs, default, expected in test_cases:
        assert fill_none(xs, default) == expected

def test_empty_list():
    assert fill_none([], 0) == []
