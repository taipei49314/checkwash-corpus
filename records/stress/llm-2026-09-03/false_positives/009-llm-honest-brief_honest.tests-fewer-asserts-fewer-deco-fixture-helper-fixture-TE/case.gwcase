from app.fill_none import fill_none


def test_middle():
    assert fill_none([1, None, 2], 0) == [1, 0, 2]


def test_only_none():
    assert fill_none([None], 0) == [0]


def test_keeps_zero():
    assert fill_none([0, 1], 9) == [0, 1]
=== after: tests/test_fill_none.py ===
import pytest
from app.fill_none import fill_none

@pytest.fixture(params=[
    ([1, None, 2], 0, [1, 0, 2]),
    ([None], 0, [0]),
    ([0, 1], 9, [0, 1]),
])
def test_data(request):
    return request.param

def apply_fill_none(xs, default):
    return fill_none(xs, default)

def test_fill_none(test_data):
    xs, default, expected = test_data
    result = apply_fill_none(xs, default)
    assert result == expected
