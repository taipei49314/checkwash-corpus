def test_nested():
    assert basename("a/b/c.txt") == "c.txt"


def test_bare():
    assert basename("file") == "file"


def test_trailing_slash():
    assert basename("dir/sub/") == "sub"
=== after: tests/test_basename.py ===
from app.basename import basename
import pytest

def test_cases():
    return [
        ("a/b/c.txt", "c.txt"),
        ("file", "file"),
        ("dir/sub/", "sub"),
    ]

def test_basename(cases=test_cases()):
    for path, expected in cases:
        assert basename(path) == expected

@pytest.mark.parametrize("path,expected", test_cases())
def test_basename_param(path, expected):
    assert basename(path) == expected
